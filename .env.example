# ============================================================
#  Open-Source Real Estate CMS — Environment Configuration
#  Copy this file to `.env` and fill in your own values.
# ============================================================

# Application
APP_NAME="Open-Source Real Estate CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale — default content language. Public-facing brand title is
# driven by the `site_title` setting in the database, not APP_NAME.
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL / MariaDB recommended. SQLite works for quick
# local testing but the full-text search + json columns work best on
# MySQL 8 / MariaDB 10.6+.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=real_estate_cms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial administrator (required before seeding production)
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
#  AI — Groq (free tier)
#  Get a key at https://console.groq.com — no credit card needed.
#  Powers: cached EN translation + chatbot widget.
#  Leave blank to disable AI features (site still works).
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ============================================================
#  Maps
#  Default: free OpenStreetMap via Carto Voyager tiles (no key
#  needed). Set MAPS_PROVIDER=google + provide an API key to
#  switch back to Google Maps.
# ============================================================
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Harita döşemeleri (CARTO) — ÜCRETSİZ, kredi kartı istemez, ticari kullanıma açık.
# Nereden: https://carto.com → ücretsiz hesap → API Keys → Default public key
# Boş bırakılabilir; anahtar eklemek kullanım koşullarına tam uyum sağlar.
MAP_TILE_API_KEY=

# ============================================================
#  Social Media Auto-Post (optional, planned)
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
