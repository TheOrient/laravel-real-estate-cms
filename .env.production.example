###############################################################
# REAL ESTATE CMS — PRODUCTION (.env) ŞABLONU
# Sunucuda bu değerleri gerçek bilgilerle doldurup .env yapın.
# ASLA git'e commit etmeyin. APP_DEBUG canlıda kesinlikle false.
###############################################################

APP_NAME="Your Real Estate Brand"
APP_ENV=production
# İlk kurulumda üretin; mevcut site taşınırken eski APP_KEY korunmalıdır.
APP_KEY=
APP_DEBUG=false               # <-- CANLIDA MUTLAKA false
APP_URL=https://your-domain.example
# APP_URL ve yönetim panelindeki site_url değerini gerçek HTTPS alan adıyla değiştirin.

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# --- Veritabanı ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=real_estate_cms
DB_USERNAME=                  # sunucudaki DB kullanıcısı
DB_PASSWORD=                  # güçlü bir parola

# --- Oturum / Güvenlik (HTTPS'te) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # <-- HTTPS'te true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- E-posta (GERÇEK SMTP; log OLMAZ) ---
# Site üzerinde e-posta adresi YAYIMLANMIYOR; bu hesap yalnızca bildirim
# göndermek için kullanılır. Gmail kullanacaksanız normal parolanız değil,
# Google Hesabı > Güvenlik > Uygulama şifreleri'nden alınan 16 haneli şifre
# girilmelidir.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 587 için smtp (STARTTLS), 465 için smtps; sağlayıcınızın ayarını kullanın.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- İsteğe bağlı: AI içerik (varsa) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

MAPS_PROVIDER=osm
LOG_LEVEL=warning
LOG_CHANNEL=daily

# Yalnızca boş veritabanına ilk kurulumda gerekli.
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

# Harita döşemeleri (CARTO) — ÜCRETSİZ, kredi kartı istemez, ticari kullanıma açık.
# Nereden: https://carto.com → ücretsiz hesap → API Keys → Default public key
# Boş bırakılabilir; anahtar eklemek kullanım koşullarına tam uyum sağlar.
MAP_TILE_API_KEY=
